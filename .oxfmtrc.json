{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortTailwindcss": {
    "stylesheet": "./demos/vue/app/assets/main.css"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".output/**",
    "**/.output/**",
    "**/.nuxt/**",
    "**/.classy/**",
    "**/vendor/**",
    "demos/laravel/**",
    "demos/react/src/App.tsx",
    "demos/unocss-react/src/App.tsx",
    "pnpm-lock.yaml"
  ]
}
